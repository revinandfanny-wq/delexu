# Firebase Web config (public client values; configure in Vercel)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account: put JSON on one line. NEVER expose to browser.
FIREBASE_SERVICE_ACCOUNT_JSON=
# UID(s) allowed to access developer panel, comma separated. Set after first Google login.
ADMIN_UIDS=

# Pterodactyl panel configs: JSON array. Keep API keys private in Vercel environment variables.
# Configure each panel's own locationId, nestId, eggId, allocationIds and resource limits.
PTERO_PANELS_JSON=[]
# Optional: set to false until you have verified the bot egg/template is installed on all panels.
PTERO_PROVISIONING_ENABLED=false
